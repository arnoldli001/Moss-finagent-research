# ==== 云端API（敏感，禁止提交真实值）====
DEEPSEEK_API_KEY=

# ==== 数据源Token ====
TUSHARE_TOKEN=

# ==== 数据库（Demo默认值，仅本地使用）====
# 存储后端：sqlite（默认，零外部依赖）| postgres（需先 docker compose up -d postgres）
DATA_BACKEND=sqlite
SQLITE_PATH=data/moss_finagent.db
POSTGRES_PASSWORD=moss_finagent
POSTGRES_DSN=postgresql+asyncpg://moss_finagent:moss_finagent@localhost:5432/moss_finagent
SQLITE_DSN=sqlite:///data/moss_finagent.db
# 查询缓存：true时为仓储套Redis装饰层（Redis不可达自动降级直连，不阻断服务）
REDIS_CACHE_ENABLED=false
DATA_CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ==== 本地模型 ====
OLLAMA_BASE_URL=http://localhost:11434

# ==== 应用 ====
LOG_LEVEL=INFO
DEBUG=false
