# ==== 云端API（敏感，禁止提交真实值；本机请复制为 .env 或写入系统环境变量）====
# ⚠️ 占位符请保持 REPLACE_ME 形态：合规门禁（tests/unit/test_compliance_gate.py）
#    会扫描本文件，任何**看起来能用**的默认值都会被判为违规。
DEEPSEEK_API_KEY=REPLACE_ME

# ==== 数据源Token ====
TUSHARE_TOKEN=

# ==== 本地行情 ====
# 迅投QMT导出CSV目录（含SH/SZ子目录；留空则不启用CSV兜底）。
# ⚠️ 2026-09 起 QMT 已降为**最低优先级且默认关闭**（终端失去行情权限）；
#    该目录里的导出文件同时会陈旧（实测停在 2026-08-31），所以它排在所有在线源之后。
# 需要恢复 QMT 时：设 QMT_ENABLED=1，并把 qmt 放进 configs/intraday.yaml 的
# intraday_sources 最前面。
LOCAL_QUOTE_DIR=D:/quantTrader/data
QMT_ENABLED=0

# ==== 东财 push2* 的 TLS SNI 阻断规避 ====
# 本机网络按 TLS SNI 阻断 push2/push2his.eastmoney.com（域名请求握手后立刻断链，
# TCP/DNS 都正常；详见 src/core/eastmoney_direct.py 的实测证据表）。
# 开启后仅在"确认被阻断"时回退「直连 IP + Host 头」，**该步 verify=False 不校验证书**。
# 关掉它会让 ETF 前复权全历史 / 分钟K长序列只剩腾讯 641 根分页与 Tushare 额度。
MOSS_EM_DIRECT=1

# ==== 数据库（Demo默认值，仅本地使用）====
# 存储后端：sqlite（默认，零外部依赖）| postgres（需先 docker compose up -d postgres）
DATA_BACKEND=sqlite
SQLITE_PATH=data/moss_finagent.db
# ⚠️ 不要在这里给"能用的默认密码"：那会诱导部署时直接照抄。
#    生产必须由密钥管理服务注入（Vault / K8s Secret），且 DSN 从同一来源拼。
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DSN=postgresql+asyncpg://moss_finagent:REPLACE_ME@localhost:5432/moss_finagent
SQLITE_DSN=sqlite:///data/moss_finagent.db
# 查询缓存：true时为仓储套Redis装饰层（Redis不可达自动降级直连，不阻断服务）
REDIS_CACHE_ENABLED=false
DATA_CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ==== 数据保留与新闻缓存（性能优化）====
# 数据点仅保留最近 N 年（按 period_date 清理超期）
DATA_RETENTION_YEARS=10
# 新闻/快讯缓存：TTL 内重复分析直接读库，不重复网络
NEWS_CACHE_ENABLED=true
NEWS_CACHE_TTL_SECONDS=600
NEWS_RETENTION_DAYS=30

# ==== 增量保留（认证/告警/通知流水；2026-09-25 数据库审计后新增）====
# 背景：此前全项目只清理 fact_data_points 与 news_cache，其余约 40 张表
# 只增不减（过期只 UPDATE 状态、查询时过滤，从不删行）。
# 单位：天。0 = 不清理。
RETENTION_NOTIFY_LOG_DAYS=180        # 通知审计流水（含登录失败埋点）
RETENTION_SESSION_DAYS=90            # 已过期/已撤销的会话
RETENTION_REMEMBER_TOKEN_DAYS=90     # 已过期的"记住我"令牌
RETENTION_VERIFICATION_CODE_DAYS=30  # 已过期/已用的验证码
RETENTION_PASSWORD_RESET_DAYS=30     # 已过期/已用的重置令牌
RETENTION_ALERT_DAYS=365             # 已过期的告警（会级联删已读记录）
RETENTION_EVENT_DAYS=730             # 事件库（删前先把告警的引用置空）

# ---- 历史行情台账：默认 0 = **不清理**，开启即不可恢复 ----
# 这些表原本是被有意永久保留的（拥挤度 refresh.py 明说"不删历史"）。
# 想控制体积再设：主库实测 sector_crowding_daily 218 万行/318MB，
# auction_snapshot 每行约 15.7KB（字节增速最快，约 235MB/年）。
RETENTION_CROWDING_DAILY_YEARS=0
RETENTION_CROWDING_METRIC_WEEKS=0
RETENTION_AUCTION_DAYS=0
RETENTION_QUANT_SELECTION_DAYS=0

# 单批删除行数（分批是硬要求：一次删几百万行会长时间持写锁，把
# 做T/资金流的写请求顶成 database is locked）
RETENTION_BATCH_SIZE=2000
RETENTION_MAX_BATCHES_PER_TABLE=500

# ==== 本地模型 ====
OLLAMA_BASE_URL=http://localhost:11434

# ==== 模型网关 ====
# 单任务累计 token 上限（超过则拒绝后续 DeepSeek 调用，防跑飞超支）。
# 默认 200000 已能覆盖绝大多数分析（实测 85 个任务：中位 4.07 万、p90 12.4 万）。
# 想更省可下调，但低于中位数会让正常分析中途被预算掐断。
LLM_TOKEN_BUDGET_PER_TASK=200000
# 思维链强度全局覆盖：留空=按层级（清洗/信息→low，核心分析/决策→high）；
# 可填 none/low/high/max（DeepSeek 官方取值），填 low 可进一步省 token/降延迟。
LLM_REASONING_EFFORT=

# ==== 应用 ====
LOG_LEVEL=INFO
DEBUG=false

# ==== 多租户与合规（详见 docs/MULTI_TENANCY_DESIGN.md）====
# 强制鉴权开关：生产必须为 1；未设置时未带凭证的请求会以本地开发身份放行
# （响应头会带 X-Tenancy: dev-bypass，且启动日志会告警）
MOSS_TENANCY_ENFORCE=0
# 身份令牌签名密钥（HMAC）——留空则所有 Bearer 令牌都判为无效
MOSS_IDENTITY_SECRET=REPLACE_ME
# 仅本地联调：允许用 X-Tenant-Id / X-Roles 等请求头声明身份。**生产必须留空**。
MOSS_ALLOW_HEADER_IDENTITY=
# 访问审计目录（与业务库分开存放，便于独立备份与只读挂载）
MOSS_AUDIT_DIR=data/audit

# ==== 事件监控与自动告警 ====
# QQ邮箱SMTP：在 QQ邮箱(mail.qq.com)→设置→账号→POP3/IMAP/SMTP/Exchange/CardDAV服务
# 开启"POP3/SMTP服务"后生成【授权码】（16位，非QQ登录密码），填到 ALERT_SMTP_AUTH_CODE
# 未配置授权码时邮件通道自动降级（仅站内WebSocket/告警中心推送），不影响扫描
ALERT_SMTP_USER=REPLACE_ME_QQ_MAIL
ALERT_SMTP_AUTH_CODE=REPLACE_ME_QQ_AUTH_CODE
# 收件人（逗号分隔；**不要在这里写真实个人邮箱** —— 本文件会进版本库）
ALERT_EMAIL_TO=REPLACE_ME
# 邮件发送分数门槛：风险类 风险分严格>69 才发；机会类 机会分>=85 才发（可调）
ALERT_EMAIL_RISK_MIN_SCORE=69
ALERT_EMAIL_OPP_MIN_SCORE=85
# 站内告警最低级别（默认medium：low档事件只入库不推送；调成low可放宽）
ALERT_MIN_LEVEL=medium
# 同事件同类型告警冷却小时数 / 置信度门槛
ALERT_COOLDOWN_HOURS=24
ALERT_CONFIDENCE_MIN=0.70
# 自定义快讯预筛关注词（逗号分隔；留空仅用内置政策/板块词表）
# ALERT_KEYWORDS=低空经济,核聚变,脑机接口
